{
  "name": "deployseal/wordpress-plugin",
  "description": "Development tooling for the DeploySeal WordPress plugin (the plugin itself has no Composer dependencies).",
  "license": "MIT",
  "require-dev": {
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "lint": "phpcs"
  }
}
